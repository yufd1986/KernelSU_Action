# KernelSU Action -- build profile for Redmi Note 9 5G (cannon)
CONFIG_ENV=config.env

# ============================================================ Kernel source ==
KERNEL_SOURCE=https://github.com/MiCode/Xiaomi_Kernel_OpenSource
KERNEL_SOURCE_BRANCH=cannon-q-oss
KERNEL_CONFIG=cannon_user_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
ARCH=arm64
KERNEL_NAME=cannon-ksu
ADD_LOCALVERSION_TO_FILENAME=true

EXTRA_CMDS:KCFLAGS=-Wno-error=strict-prototypes
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# =================================================================== Clang ==
CLANG_BRANCH=master-kernel-build-2022
CLANG_VERSION=r450784e
USE_CUSTOM_CLANG=false
USE_LLVM=false

# ===================================================================== GCC ==
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# =============================================================== KernelSU ===
KSU_VARIANT=kernelsu
KSU_REF=v0.9.5
KSU_HOOK_MODE=auto

ENABLE_SUSFS=false
ENABLE_PATH_UMOUNT=true
ENABLE_HIDE_STUFF=false
ENABLE_KPM=false

# ================================================================ Kconfig ===
ADD_KPROBES_CONFIG=true
ADD_OVERLAYFS_CONFIG=true
DISABLE_LTO=true
DISABLE_CC_WERROR=true

EXTRA_DEFCONFIG=

# ============================================================= AnyKernel3 ===
USE_CUSTOM_ANYKERNEL3=false

# ============================================================== Packaging ===
NEED_DTBO=false
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=

# ================================================================= Runner ===
ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
